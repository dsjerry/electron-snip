{
  "name": "electron-snip",
  "version": "0.1.0",
  "description": "Electron 跨屏截图 SDK：框选、遮罩、标注、贴图、复制 / 保存",
  "type": "module",
  "license": "MIT",
  "author": "dsjerry",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./preload": "./dist/preload.cjs",
    "./renderer/*": "./dist/renderer/*",
    "./annotations": {
      "types": "./dist/annotations/annotations.d.ts",
      "import": "./dist/annotations/annotations.js"
    },
    "./annotations.css": "./dist/annotations/annotations.css",
    "./utils": {
      "types": "./dist/utils/utils.d.ts",
      "import": "./dist/utils/utils.js"
    },
    "./ocr": {
      "types": "./dist/ocr/ocr.d.ts",
      "import": "./dist/ocr/ocr.js",
      "require": "./dist/ocr/ocr.cjs"
    },
    "./scroll": {
      "types": "./dist/scroll/scroll.d.ts",
      "import": "./dist/scroll/scroll.js",
      "require": "./dist/scroll/scroll.cjs"
    },
    "./record": {
      "types": "./dist/record/record.d.ts",
      "import": "./dist/record/record.js",
      "require": "./dist/record/record.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "smoke": "electron scripts/smoke-electron.cjs",
    "prepare": "npm run build",
    "example": "electron examples/basic/main.cjs",
    "smoke:record": "electron scripts/smoke-record.cjs"
  },
  "peerDependencies": {
    "electron": ">=43"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@vitest/browser-playwright": "4.1.12",
    "electron": "44.4.3",
    "eslint": "10.14.0",
    "globals": "17.13.0",
    "lucide-static": "1.48.0",
    "playwright": "1.65.0",
    "prettier": "3.10.0",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "4.1.12"
  },
  "dependencies": {
    "get-windows": "10.0.0"
  },
  "allowScripts": {
    "get-windows@10.0.0": true,
    "esbuild@0.27.7": true
  },
  "typesVersions": {
    "*": {
      "annotations": [
        "./dist/annotations/annotations.d.ts"
      ],
      "utils": [
        "./dist/utils/utils.d.ts"
      ],
      "ocr": [
        "./dist/ocr/ocr.d.ts"
      ],
      "scroll": [
        "./dist/scroll/scroll.d.ts"
      ],
      "record": [
        "./dist/record/record.d.ts"
      ]
    }
  },
  "optionalDependencies": {
    "koffi": "3.3.2"
  }
}
